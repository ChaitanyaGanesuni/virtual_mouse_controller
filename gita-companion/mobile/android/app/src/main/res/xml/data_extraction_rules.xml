<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing leaves the phone through cloud backup or
     device-to-device transfer. Sign-in tokens are bound to this device's
     Keystore, and the journal is private; data moves between phones only
     through the user's own sync with a recovery code. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
